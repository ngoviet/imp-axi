{
  "name": "imp-axi",
  "version": "0.1.0",
  "description": "AXI wrapper for the Impeccable design detector: TOON summary by rule and file instead of hundreds of KB of JSON",
  "type": "module",
  "license": "MIT",
  "author": "ngoviet",
  "homepage": "https://github.com/ngoviet/imp-axi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngoviet/imp-axi.git"
  },
  "bugs": {
    "url": "https://github.com/ngoviet/imp-axi/issues"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "toon",
    "impeccable",
    "design",
    "ui",
    "claude-code"
  ],
  "bin": {
    "imp-axi": "dist/bin/imp-axi.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && eslint . && vitest run",
    "install:global": "tsup && node -e \"require('fs').mkdirSync('build/pack',{recursive:true})\" && npm pack --pack-destination build/pack && node -e \"require('child_process').execSync('npm install -g build/pack/imp-axi-' + require('./package.json').version + '.tgz', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
